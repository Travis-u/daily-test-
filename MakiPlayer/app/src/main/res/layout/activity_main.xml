<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B111A">

    <LinearLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="讲座书架"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="讲座书架"
            android:textColor="#F2F7FB"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="非官方个人学习工具"
            android:textColor="#AFC3D6"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="不复制、不下载、不缓存视频；内容与播放均由原平台提供。"
            android:textColor="#7F95A8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/openButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="34dp"
            android:backgroundTint="#173A59"
            android:text="打开收藏的官方合集"
            android:textAllCaps="false"
            android:textColor="#EDF6FF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="合集内容如有更新，会直接由原页面显示；本应用不抓取平台目录数据。"
            android:textColor="#687D90"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/browserPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05080C"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B111A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#173A59"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="← 书架"
                android:textAllCaps="false"
                android:textColor="#EAF4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="原站页面"
                android:textColor="#C9D9E8"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>
